      <div class="pt-2 border-t border-slate-800 space-y-3">
        <button onclick="generateAndCopyUrl()" class="w-full bg-yellow-500 hover:bg-yellow-400 text-slate-950 font-bold py-3 rounded-xl transition flex items-center justify-center gap-2">
          <i class="fa-solid fa-copy"></i> Generate & Copy Scout Link
