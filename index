  <!-- JAVASCRIPT LOGIC (URL PARAMETER DECODING & ENCODING) -->
  <script>
    // デフォルトの基本データ
    const defaultData = {
      name: "AKIHIRO FUJIKAWA",
      position: "LW / LM / RB",
      gpa: "3.28 / 4.00",
      heightWeight: "170cm / 68kg",
      ncaaId: "250663641",
      harcumStats: "7 Matches | 1 Goal | 1 Assist",
      upslStats: "SoCal South Division | Primary Winger",
      email: "fujiakihiro8@gmail.com",
      ytHarcum: "GYwZrTe9pqw",
      ytUpsl: "mDg81hUIL8k"
    };

    let currentProfile = { ...defaultData };

    // 1. URLパラメータからデータをロードして表示
    function loadProfileFromUrl() {
      const urlParams = new URLSearchParams(window.location.search);
      const encodedData = urlParams.get('data');

      if (encodedData) {
        try {
          const jsonString = decodeURIComponent(escape(atob(encodedData)));
          const parsedData = JSON.parse(jsonString);
          currentProfile = { ...defaultData, ...parsedData };
        } catch (e) {
          console.error("Failed to parse profile data from URL parameter", e);
        }
      }

      renderProfile(currentProfile);
    }

    // 2. 画面要素へのデータ反映
    function renderProfile(data) {
      document.getElementById('disp-name').innerText = data.name;
      document.getElementById('disp-position').innerText = data.position;
      document.getElementById('disp-gpa').innerText = data.gpa;
      document.getElementById('disp-physique').innerText = data.heightWeight;
      document.getElementById('disp-ncaaid').innerText = data.ncaaId;
      document.getElementById('disp-stats-harcum').innerText = data.harcumStats;
      document.getElementById('disp-stats-upsl').innerText = data.upslStats;
      
      document.getElementById('disp-email-btn').href = `mailto:${data.email}`;
      document.getElementById('disp-email-link').href = `mailto:${data.email}`;
      document.getElementById('disp-email-link').innerHTML = `<i class="fa-solid fa-envelope"></i> ${data.email}`;

      if (data.ytHarcum) {
        document.getElementById('iframe-harcum').src = `https://www.youtube.com/embed/${data.ytHarcum}`;
      }
      if (data.ytUpsl) {
        document.getElementById('iframe-upsl').src = `https://www.youtube.com/embed/${data.ytUpsl}`;
      }
    }

    // 3. モーダル表示とフォーム入力同期
    function openEditModal() {
      document.getElementById('input-name').value = currentProfile.name;
      document.getElementById('input-position').value = currentProfile.position;
      document.getElementById('input-gpa').value = currentProfile.gpa;
      document.getElementById('input-stats-harcum').value = currentProfile.harcumStats;
      document.getElementById('input-email').value = currentProfile.email;
      document.getElementById('input-yt-harcum').value = currentProfile.ytHarcum;
      document.getElementById('input-yt-upsl').value = currentProfile.ytUpsl;

      document.getElementById('edit-modal').classList.remove('hidden');
    }

    function closeEditModal() {
      document.getElementById('edit-modal').classList.add('hidden');
    }

    // 4. 新しいデータの共有用URL生成 & クリップボードにコピー
    function generateAndCopyUrl() {
      const updatedData = {
        ...currentProfile,
        name: document.getElementById('input-name').value,
        position: document.getElementById('input-position').value,
        gpa: document.getElementById('input-gpa').value,
        harcumStats: document.getElementById('input-stats-harcum').value,
        email: document.getElementById('input-email').value,
        ytHarcum: document.getElementById('input-yt-harcum').value,
        ytUpsl: document.getElementById('input-yt-upsl').value
      };

      // Base64エンコード
      const jsonString = JSON.stringify(updatedData);
      const encodedData = btoa(unescape(encodeURIComponent(jsonString)));

      // URL生成
      const shareableUrl = `${window.location.origin}${window.location.pathname}?data=${encodeURIComponent(encodedData)}`;

      // クリップボードにコピー
      navigator.clipboard.writeText(shareableUrl).then(() => {
        alert("Scout share link copied to clipboard!\n\nThis URL directly contains your updated stats.");
        renderProfile(updatedData);
        currentProfile = updatedData;
        closeEditModal();
      }).catch(err => {
        alert("Failed to copy URL automatically. Check console.");
        console.log("Shareable URL:", shareableUrl);
      });
    }

    // 初期化実行
    window.addEventListener('DOMContentLoaded', loadProfileFromUrl);
  </script>
